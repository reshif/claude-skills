  "delete_expense": {"description": "Delete an expense.", "args": {"expense_id": {"ref": "expenses"}}, "writes": ["expenses"]},
  "approve_expense": {"description": "Approve a submitted expense.", "args": {"expense_id": {"ref": "expenses"}, "approver_id": {"ref": "users", "self": true}}, "writes": ["expenses"]}
