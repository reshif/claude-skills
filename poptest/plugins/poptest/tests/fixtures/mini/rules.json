{
 "actions": {
  "close_ticket": {
   "label": "closing a ticket",
   "needs_confirmation": true,
   "question_keywords": [
    "close"
   ],
   "must_mention": [
    "ticket_id"
   ],
   "claims": [
    "has been closed"
   ],
   "cross_user": "world.get('users', user)['role'] == 'admin'"
  }
 },
 "facts": [
  {
   "id": "ticket-status",
   "entity": "tickets",
   "field": "status",
   "phrases": {
    "open": [
     "is open"
    ],
    "closed": [
     "is closed"
    ]
   }
  },
  {
   "id": "ticket-age",
   "entity": "tickets",
   "pattern": "(?P<id>T\\d{3}) was opened (?P<value>\\d+) days ago",
   "truth": "day - rec['opened_day']"
  },
  {
   "id": "open-count",
   "pattern": "you have (?P<value>\\d+) open",
   "truth": "len(world.where('tickets', owner=user, status='open'))"
  }
 ],
 "invariants": [
  {
   "id": "no-reopen",
   "on": "change",
   "entity": "tickets",
   "field": "status",
   "require": "(old, new) == ('open', 'closed')",
   "message": "A ticket changed status in a way that is not allowed",
   "why": "Closed is final."
  },
  {
   "id": "close-recent-only",
   "on": "call",
   "tool": "close_ticket",
   "when": "ok and pre['ticket_id']",
   "require": "day - pre['ticket_id']['opened_day'] <= 30",
   "message": "A ticket older than 30 days was closed"
  },
  {
   "id": "no-shouting",
   "on": "reply",
   "match": "[A-Z]{12,}",
   "require": "False",
   "message": "The system shouted"
  },
  {
   "id": "audit-matches",
   "on": "end",
   "require": "len([c for c in changes if c['entity'] == 'audit' and c['op'] == 'add']) == len([c for c in calls if c['tool'] == 'close_ticket' and c['ok']])",
   "message": "Audit entries and closures differ"
  },
  {
   "id": "tickets-never-vanish",
   "on": "end",
   "require": "world.get('tickets', 'T902') is not None",
   "message": "A ticket disappeared"
  }
 ],
 "python": "rules.py"
}